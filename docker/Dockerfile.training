FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (including compiler for native extensions and LightGBM)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgomp1 \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .
COPY requirements-dev.txt .

# Install dependencies (full training and dev dependencies)
RUN pip install --no-cache-dir -r requirements-dev.txt

# Copy codebase
COPY . .

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV MLFLOW_TRACKING_URI=mlruns

# Command to execute training (can be overridden)
CMD ["bash", "scripts/train_all.sh"]
